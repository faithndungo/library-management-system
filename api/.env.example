# Environment Variables Template
# Copy this file to .env and replace the placeholder values with your actual database credentials.
# IMPORTANT: Never commit your actual .env file or credentials to source control.

# PostgreSQL Connection String placeholder for local or hosted database (e.g. Supabase, Neon, Railway)
DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database_name>?schema=public"

