{
  "info": {
    "_postman_id": "b8f2d1e4-7a32-4299-9c5e-8e4a9e5df612",
    "name": "Library Management System API",
    "description": "Comprehensive Postman collection covering all endpoints: Auth, Users Profile, Genres CRUD, and Books Catalog CRUD with query filtering, search, pagination, and role-based access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron.john@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"John Doe\",\n  \"role\": \"PATRON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new library patron. Password is automatically hashed with bcrypt."
          },
          "response": []
        },
        {
          "name": "Register Librarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian.mary@library.org\",\n  \"password\": \"adminPassword123\",\n  \"name\": \"Mary Librarian\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new librarian with staff administrative privileges."
          },
          "response": []
        },
        {
          "name": "Login (Patron)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.environment.set('patronToken', response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron.john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a patron with email and password, returning a signed JWT access token. Rate limited with @nestjs/throttler."
          },
          "response": []
        },
        {
          "name": "Login (Librarian)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.environment.set('librarianToken', response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@library.org\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates seeded librarian user to obtain a JWT token for guarded catalog mutation routes."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Authenticated Profile (Stretch)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Retrieves the authenticated user identity via @Req() in UsersController using the JwtAuthGuard."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cyberpunk\",\n  \"description\": \"A subgenre of science fiction in a dystopian futuristic setting tendering towards high tech and low life.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Creates a new catalog genre with DTO validation."
          },
          "response": []
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Retrieves all genres along with count of books in each."
          },
          "response": []
        },
        {
          "name": "Get Genre by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Retrieves a single genre by its UUID and its associated books."
          },
          "response": []
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated descriptive summary for the genre.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Updates an existing genre's name or description using UpdateGenreDto."
          },
          "response": []
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            },
            "description": "Deletes a genre by its UUID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get Books (Filtered, Search, Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search=Dune&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "{{genreId}}",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "Dune"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Public endpoint to query books by genreId, case-insensitive title/author search, and pagination."
          },
          "response": []
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Retrieves a single book with its genre and reviews."
          },
          "response": []
        },
        {
          "name": "Create Book (Guarded - Librarian Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Children of Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0441104024\",\n  \"totalCopies\": 5,\n  \"genreId\": \"{{genreId}}\",\n  \"publicationYear\": 1976\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Creates a new book. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN). Validated with CreateBookDto."
          },
          "response": []
        },
        {
          "name": "Update Book (Guarded - Librarian Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Updates an existing book. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          },
          "response": []
        },
        {
          "name": "Delete Book (Guarded - Librarian Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Deletes a book from the catalog. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "librarianToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "patronToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "genreId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "",
      "type": "string"
    }
  ]
}

